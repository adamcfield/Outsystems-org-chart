{
  "name": "@adamcfield/d3-org-chart",
  "version": "4.0.0-alpha.0",
  "private": true,
  "description": "Highly customizable org chart, created with d3. Maintained fork of bumbeishvili/org-chart.",
  "keywords": [
    "d3",
    "d3-module",
    "d3-org-chart",
    "org-chart",
    "hierarchy",
    "employee"
  ],
  "license": "MIT",
  "type": "module",
  "main": "./dist/d3-org-chart.esm.js",
  "module": "./dist/d3-org-chart.esm.js",
  "types": "./index.d.ts",
  "unpkg": "./dist/d3-org-chart.min.js",
  "jsdelivr": "./dist/d3-org-chart.min.js",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./dist/d3-org-chart.esm.js",
      "default": "./dist/d3-org-chart.esm.js"
    },
    "./standalone": "./dist/d3-org-chart.js",
    "./standalone.min": "./dist/d3-org-chart.min.js"
  },
  "files": [
    "dist",
    "src",
    "index.js",
    "index.d.ts"
  ],
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/adamcfield/outsystems-org-chart.git"
  },
  "bugs": {
    "url": "https://github.com/adamcfield/outsystems-org-chart/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "npm run build && node --test test/*.test.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "d3-array": "^3.2.4",
    "d3-flextree": "2.1.2",
    "d3-hierarchy": "^3.1.2",
    "d3-selection": "^3.0.0",
    "d3-shape": "^3.2.0",
    "d3-transition": "^3.0.1",
    "d3-zoom": "^3.0.0"
  },
  "devDependencies": {
    "@types/d3-hierarchy": "^3.1.7",
    "@types/d3-selection": "^3.0.11",
    "@types/d3-shape": "^3.1.7",
    "@types/d3-zoom": "^3.0.8",
    "esbuild": "^0.25.0",
    "playwright-core": "^1.55.0",
    "typescript": "^5.9.3"
  }
}
